DATABASE_URL=
DIRECT_URL=
# Direct PostgreSQL connection used only for explicit backup operations
BACKUP_DATABASE_URL=
# Explicit opt-in required when BACKUP_DATABASE_URL is remote
ALLOW_REMOTE_DB_BACKUP=false

# Local-only isolated restore drill target; remote targets are always blocked
RESTORE_DATABASE_URL=
# PostgreSQL custom-format .dump archive used by the local restore drill
RESTORE_DUMP_PATH=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
BREVO_API_KEY=
BREVO_SENDER_NAME=AkademiaSportive
BREVO_SENDER_EMAIL=

# Safety: required only for intentional remote Prisma DB operations
ALLOW_REMOTE_DB_OPERATIONS=false
