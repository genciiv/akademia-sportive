enum DrillDifficulty {
  EASY
  MEDIUM
  HARD
}

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  PLATFORM_ADMIN
  USER
}

enum AcademyRole {
  OWNER
  ADMIN
  SPORTS_DIRECTOR
  HEAD_COACH
  COACH
  ASSISTANT_COACH
  FINANCE
  RECEPTIONIST
  MEMBER
}

enum AcademyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

model User {
  id            String  @id @default(cuid())
  name          String
  firstName     String?
  lastName      String?
  email         String  @unique
  emailVerified Boolean @default(false)
  phone         String?
  image         String?

  role PlatformRole @default(USER)

  sessions Session[]
  accounts Account[]

  memberships    AcademyMembership[]
  ownedAcademies Academy[]           @relation("AcademyOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id         String @id
  issuer     String
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

model Academy {
  matches Match[]
  drills  Drill[]
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  email   String?
  phone   String?
  logo    String?
  address String?
  city    String?
  country String?

  status AcademyStatus @default(TRIAL)

  ownerId String
  owner   User   @relation("AcademyOwner", fields: [ownerId], references: [id])

  memberships AcademyMembership[]
  branches    AcademyBranch[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  players            Player[]
  teams              Team[]
  trainingSessions   TrainingSession[]
  coaches            Coach[]
  scoutingCandidates ScoutingCandidate[]
  calendarEvents     CalendarEvent[]
  playerFees         PlayerFee[]
  playerCharges      PlayerCharge[]
  cashPayments       CashPayment[]
  expenses           Expense[]
  guardians          Guardian[]
  playerGuardians    PlayerGuardian[]
  notifications      Notification[]
  academySeasons     AcademySeason[]

  @@index([ownerId])
  @@index([status])
}

model AcademySeason {
  id String @id @default(cuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  name String

  startsAt DateTime
  endsAt   DateTime

  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academyId, name])
  @@index([academyId])
  @@index([academyId, isActive])
  @@index([academyId, startsAt, endsAt])
}

model AcademyMembership {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  academyId String
  academy   Academy          @relation(fields: [academyId], references: [id], onDelete: Cascade)
  role      AcademyRole
  status    MembershipStatus @default(ACTIVE)

  joinedAt DateTime @default(now())

  coachProfile Coach?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, academyId])
  @@index([academyId])
  @@index([userId])
  @@index([academyId, role])
}

model AcademyBranch {
  id String @id @default(cuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  name    String
  address String?
  city    String?
  country String?
  phone   String?
  email   String?

  isActive Boolean @default(true)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  teams            Team[]
  trainingSessions TrainingSession[]

  @@index([academyId])
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
  INJURED
  SUSPENDED
  LEFT
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  NOT_SPECIFIED
}

enum SportType {
  FOOTBALL
  BASKETBALL
  VOLLEYBALL
  TENNIS
  SWIMMING
  HANDBALL
  MARTIAL_ARTS
  ATHLETICS
  OTHER
}

model Player {
  matchEvents  MatchEvent[]
  performances PlayerMatchPerformance[]
  matches      MatchPlayer[]
  id           String                   @id @default(cuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  dateOfBirth DateTime?
  gender      Gender    @default(NOT_SPECIFIED)

  email String?
  phone String?

  guardianName  String?
  guardianPhone String?
  guardianEmail String?

  position     String?
  jerseyNumber Int?

  photo String?
  notes String?

  status PlayerStatus @default(ACTIVE)

  teams        TeamPlayer[]
  attendances  TrainingAttendance[]
  fees         PlayerFee[]
  charges      PlayerCharge[]
  cashPayments CashPayment[]
  guardians    PlayerGuardian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academyId])
  @@index([academyId, status])
  @@index([academyId, lastName, firstName])
}

model Guardian {
  id String @id @default(cuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  phone String?
  email String?

  address String?
  notes   String?

  players PlayerGuardian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academyId])
  @@index([academyId, lastName, firstName])
  @@index([academyId, phone])
  @@index([academyId, email])
}

model PlayerGuardian {
  id String @id @default(cuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  relationship String?
  isPrimary    Boolean @default(false)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  trainingSession   TrainingSession? @relation(fields: [trainingSessionId], references: [id])
  trainingSessionId String?

  @@unique([playerId, guardianId])
  @@index([academyId])
  @@index([playerId])
  @@index([guardianId])
}

model Team {
  id String @id @default(cuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  branchId String?
  branch   AcademyBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name String

  sport SportType

  ageGroup String?
  season   String?

  description String?

  status TeamStatus @default(ACTIVE)

  players          TeamPlayer[]
  coaches          CoachTeam[]
  trainingSessions TrainingSession[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  matches       Match[]
  notifications Notification[]

  @@unique([academyId, name])
  @@index([academyId])
  @@index([academyId, status])
  @@index([branchId])
}

enum NotificationAudience {
  ALL
  TEAM
}

enum NotificationPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum NotificationStatus {
  ACTIVE
  ARCHIVED
}

model Notification {
  id String @id @default(cuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  title   String
  message String

  audience NotificationAudience @default(ALL)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  priority NotificationPriority @default(NORMAL)
  status   NotificationStatus   @default(ACTIVE)

  publishedAt DateTime  @default(now())
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academyId])
  @@index([academyId, status])
  @@index([academyId, publishedAt])
  @@index([teamId])
}

model TeamPlayer {
  id String @id @default(cuid())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, playerId])
  @@index([teamId])
  @@index([playerId])
}

enum CoachStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LEFT
}

enum TrainingSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Coach {
  id String @id @default(cuid())

  membershipId String?            @unique
  membership   AcademyMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  email String?
  phone String?

  dateOfBirth DateTime?
  photo       String?

  specialization String?
  license        String?
  notes          String?

  status CoachStatus @default(ACTIVE)

  teams    CoachTeam[]
  sessions TrainingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academyId])
  @@index([academyId, status])
  @@index([academyId, lastName, firstName])
}

model CoachTeam {
  id String @id @default(cuid())

  coachId String
  coach   Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  isHeadCoach Boolean @default(false)
  isActive    Boolean @default(true)

  assignedAt DateTime  @default(now())
  leftAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([coachId, teamId])
  @@index([coachId])
  @@index([teamId])
}

model TrainingSession {
  sessionDrills TrainingSessionDrill[]
  id            String                 @id @default(cuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  coachId String?
  coach   Coach?  @relation(fields: [coachId], references: [id], onDelete: SetNull)

  branchId String?
  branch   AcademyBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  title String

  startsAt DateTime
  endsAt   DateTime?

  location String?

  description String?
  notes       String?

  status TrainingSessionStatus @default(SCHEDULED)

  attendances  TrainingAttendance[]
  fees         PlayerFee[]
  charges      PlayerCharge[]
  cashPayments CashPayment[]
  guardians    PlayerGuardian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academyId])
  @@index([teamId])
  @@index([coachId])
  @@index([branchId])
  @@index([academyId, startsAt])
  @@index([academyId, status])
}

model TrainingAttendance {
  id String @id @default(cuid())

  trainingSessionId String
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  status AttendanceStatus @default(PRESENT)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trainingSessionId, playerId])
  @@index([trainingSessionId])
  @@index([playerId])
}

model Drill {
  trainingSessions TrainingSessionDrill[]
  id               String                 @id @default(cuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  name        String
  category    String?
  sport       String?
  objective   String?
  durationMin Int?
  difficulty  DrillDifficulty @default(MEDIUM)

  equipment   String?
  description String?
  notes       String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academyId])
  @@index([academyId, isActive])
  @@index([academyId, category])
  @@index([academyId, sport])
  @@index([academyId, name])
}

model TrainingSessionDrill {
  id String @id @default(cuid())

  trainingSessionId String
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)

  drillId String
  drill   Drill  @relation(fields: [drillId], references: [id], onDelete: Cascade)

  order       Int
  durationMin Int?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trainingSessionId, drillId])
  @@index([trainingSessionId])
  @@index([trainingSessionId, order])
  @@index([drillId])
}

enum MatchStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  POSTPONED
}

enum MatchType {
  FRIENDLY
  LEAGUE
  CUP
  TOURNAMENT
  OTHER
}

model Match {
  events       MatchEvent[]
  matchPlayers MatchPlayer[]
  performances PlayerMatchPerformance[]
  id           String                   @id @default(cuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  opponentName String

  matchType MatchType   @default(FRIENDLY)
  status    MatchStatus @default(SCHEDULED)

  startsAt DateTime
  location String?
  isHome   Boolean  @default(true)

  ourScore      Int?
  opponentScore Int?

  competitionName String?
  round           String?

  description String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academyId])
  @@index([academyId, startsAt])
  @@index([academyId, status])
  @@index([teamId])
}

enum MatchPlayerRole {
  STARTER
  SUBSTITUTE
}

model MatchPlayer {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  role MatchPlayerRole @default(SUBSTITUTE)

  jerseyNumber  Int?
  position      String?
  minutesPlayed Int     @default(0)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([playerId])
  @@index([matchId, role])
}

enum MatchEventType {
  GOAL
  ASSIST
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION_IN
  SUBSTITUTION_OUT
}

model PlayerMatchPerformance {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  shots         Int @default(0)
  shotsOnTarget Int @default(0)

  passesAttempted Int @default(0)
  passesCompleted Int @default(0)

  dribblesAttempted Int @default(0)
  dribblesCompleted Int @default(0)

  duelsWon Int @default(0)

  tackles       Int @default(0)
  interceptions Int @default(0)

  foulsCommitted Int @default(0)
  foulsWon       Int @default(0)

  coachRating Decimal?
  coachNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([playerId])
}

model MatchEvent {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  type MatchEventType

  minute      Int
  extraMinute Int?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchId])
  @@index([playerId])
  @@index([matchId, type])
  @@index([matchId, minute])
}

enum ScoutingStatus {
  NEW
  OBSERVING
  SHORTLISTED
  TRIAL
  REJECTED
  SIGNED
}

enum ScoutingPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ScoutingCandidate {
  id String @id @default(cuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  dateOfBirth DateTime?
  gender      Gender    @default(NOT_SPECIFIED)

  sport SportType

  position    String?
  currentClub String?

  nationality String?
  city        String?

  email String?
  phone String?

  guardianName  String?
  guardianPhone String?
  guardianEmail String?

  photo String?

  status   ScoutingStatus   @default(NEW)
  priority ScoutingPriority @default(MEDIUM)

  technicalRating Decimal?
  physicalRating  Decimal?
  tacticalRating  Decimal?
  mentalRating    Decimal?
  overallRating   Decimal?

  strengths  String?
  weaknesses String?
  notes      String?

  observations ScoutingObservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academyId])
  @@index([academyId, status])
  @@index([academyId, priority])
  @@index([academyId, sport])
  @@index([academyId, lastName, firstName])
}

model ScoutingObservation {
  id String @id @default(cuid())

  candidateId String
  candidate   ScoutingCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  observedAt DateTime @default(now())

  eventName String?
  location  String?

  observerName String?

  technicalRating Decimal?
  physicalRating  Decimal?
  tacticalRating  Decimal?
  mentalRating    Decimal?
  overallRating   Decimal?

  strengths  String?
  weaknesses String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([candidateId, observedAt])
}

enum CalendarEventType {
  MEETING
  MEDICAL
  TRIAL
  TOURNAMENT
  ADMINISTRATIVE
  OTHER
}

model CalendarEvent {
  id String @id @default(cuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  title String
  type  CalendarEventType @default(OTHER)

  startsAt DateTime
  endsAt   DateTime?

  location    String?
  description String?
  notes       String?

  teamId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academyId])
  @@index([academyId, startsAt])
  @@index([academyId, type])
  @@index([teamId])
}

enum PlayerChargeStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model PlayerFee {
  id String @id @default(cuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  amountLek Int

  description String?

  validFrom  DateTime  @default(now())
  validUntil DateTime?

  isActive Boolean @default(true)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  trainingSession   TrainingSession? @relation(fields: [trainingSessionId], references: [id])
  trainingSessionId String?

  @@index([academyId])
  @@index([playerId])
  @@index([academyId, isActive])
}

model PlayerCharge {
  id String @id @default(cuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  title String

  amountLek Int

  dueDate DateTime?

  periodMonth Int?
  periodYear  Int?

  status PlayerChargeStatus @default(UNPAID)

  notes String?

  payments CashPayment[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  trainingSession   TrainingSession? @relation(fields: [trainingSessionId], references: [id])
  trainingSessionId String?

  @@index([academyId])
  @@index([playerId])
  @@index([academyId, status])
  @@index([academyId, dueDate])
  @@index([playerId, periodYear, periodMonth])
}

enum ExpenseCategory {
  SALARY
  RENT
  EQUIPMENT
  TRANSPORT
  MEDICAL
  TOURNAMENT
  UTILITIES
  MARKETING
  OTHER
}

model Expense {
  id          String          @id @default(cuid())
  academyId   String
  academy     Academy         @relation(fields: [academyId], references: [id], onDelete: Cascade)
  category    ExpenseCategory @default(OTHER)
  title       String
  amountLek   Int
  expenseDate DateTime        @default(now())
  description String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([academyId])
  @@index([academyId, expenseDate])
  @@index([academyId, category])
}

model CashPayment {
  id String @id @default(cuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  chargeId String
  charge   PlayerCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  amountLek Int

  paidAt DateTime @default(now())

  notes String?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  trainingSession   TrainingSession? @relation(fields: [trainingSessionId], references: [id])
  trainingSessionId String?

  @@index([academyId])
  @@index([playerId])
  @@index([chargeId])
  @@index([academyId, paidAt])
}
